# ОБЯЗАТЕЛЬНО
BOT_TOKEN=

# После первого запуска напишите боту /myid.
# Затем впишите полученный ID сюда.
ADMIN_USER_IDS=

# Публичный HTTPS URL Bothost.
# Например: https://censor-bot.example.ru/webhook
WEBHOOK_URL=

# Секрет Webhook: 5-256 символов.
WEBHOOK_SECRET=

# Bothost обычно сам передаёт PORT.
PORT=8080

# Постоянная база Bothost.
DATABASE_PATH=/app/data/censor.db

LOG_LEVEL=INFO

# Сколько часов пользователь считается новичком для антиспама.
NEW_USER_PROTECTION_HOURS=24

# Разрешить рекламный модуль для бесплатных чатов.
FREE_AD_ENABLED=true
